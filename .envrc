# Load repo-local dotenv files deterministically:
# 1. .env.local
# 2. .env.*.local in lexical order
#
# Supports regular files and FIFO mounts used by 1Password environments.

load_dotenv_locals() {
  local path
  local restore_nullglob
  local -a dotenv_files=()

  if [[ -e .env.local || -p .env.local ]]; then
    dotenv_files+=(.env.local)
  fi

  restore_nullglob=$(shopt -p nullglob)
  shopt -s nullglob
  for path in .env.*.local; do
    [[ $path == ".env.local" ]] && continue
    [[ -e $path || -p $path ]] || continue
    dotenv_files+=("$path")
  done
  eval "$restore_nullglob"

  for path in "${dotenv_files[@]}"; do
    if [[ -f $path ]]; then
      watch_file "$path"
    fi
    eval "$(direnv dotenv bash "$path")" || return 1
  done
}

load_dotenv_locals
