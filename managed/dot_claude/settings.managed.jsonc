{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16000",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_SHELL": "/opt/homebrew/bin/bash",
    "ENABLE_TOOL_SEARCH": "true",
    "NODE_USE_SYSTEM_CA": "1"
  },
  // Claude Code runs CLAUDE_ENV_FILE text before every Bash command, so mise applies the
  // environment of each command's starting directory. The shell snapshot keeps no exports, so this
  // cannot live in ~/.bashrc. `-s bash` must match CLAUDE_CODE_SHELL. The hook reruns on
  // compaction and appends to the same file, so the grep guard keeps the line from repeating.
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF 'mise hook-env' \"$CLAUDE_ENV_FILE\" || echo 'eval \"$(mise hook-env -s bash 2>/dev/null)\"' >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ]
  },
  // The marketplace plugins replace these bundled skills; keep them reachable only by name.
  "skillOverrides": {
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "extraKnownMarketplaces": {
    "0xa3b-marketplace": {
      "source": {
        "source": "github",
        "repo": "0xA3B/skills"
      },
      "autoUpdate": true
    }
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read(~/.claude/settings.json)",
      "Read(~/.claude/statusline-command.sh)",
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/rules/**)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh auth status)",
      "Bash(gh auth status --active --hostname *)",
      "Bash(op whoami)",
      "Bash(op account list *)",
      "Bash(op account get *)"
    ],
    "deny": [
      "AskUserQuestion",
      "mcp__ccd_turn__wrap_up",
      "Bash(* --show-token*)",
      "Bash(ntn auth token*)",
      "Bash(ntn * auth token*)",
      "Bash(ntn auth * token*)",
      "Bash(codex *--dangerously-bypass-approvals-and-sandbox*)",
      "Bash(codex *--yolo*)",
      "Bash(codex *danger-full-access*)",
      "Bash(claude *--dangerously-skip-permissions*)",
      "Bash(claude *bypassPermissions*)",
      "Bash(gh auth status --show-token *)",
      "Bash(gh auth status -t *)",
      "Bash(gh auth status * --show-token *)",
      "Bash(gh auth status * -t *)",
      "Bash(gh auth status * -t)",
      "Bash(gh auth token*)",
      "Bash(security find-generic-password -g *)",
      "Bash(security find-generic-password * -g)",
      "Bash(security find-generic-password * -g *)",
      "Bash(security find-generic-password -w *)",
      "Bash(security find-generic-password * -w)",
      "Bash(security find-generic-password * -w *)",
      // Read deny rules also become sandbox read denies, so these paths stay unreadable to sandboxed
      // commands. Dotenv, npmrc, and PEM files stay readable: denying them broke commands that load
      // .env files, npm, and CA certificate stores.
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/keys/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/sso/**)",
      "Read(~/.aws/cli/cache/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(**/*.key)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.netrc)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.codex/auth.json)"
    ],
    // Content-scoped ask rules prompt the user even in auto mode; the classifier cannot clear them.
    "ask": [
      "Bash(sudo *)",
      "Bash(gh auth login *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(uv publish *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    // Exclude only commands that need what the sandbox withholds: the commit-signing agent, SSH
    // remotes, or credentials outside the sandbox. Sandboxed gh needs SSL_CERT_FILE, because the
    // sandbox blocks the macOS trust service Go uses to verify TLS. A sudo entry has no effect:
    // calls that start with sudo always stay sandboxed.
    "excludedCommands": [
      "git commit *",
      "git rebase *",
      "git merge *",
      "git cherry-pick *",
      "git revert *",
      "git tag *",
      "git am *",
      "git push *",
      "git fetch *",
      "git pull *",
      "git ls-remote *",
      "git clone *",
      "git submodule *",
      "gh pr checkout *",
      "gh repo clone *",
      "ntn *",
      "op *",
      "codex *",
      "claude *",
      "aws *",
      "kubectl *",
      "docker *",
      "ssh *"
    ],
    "filesystem": {
      "allowWrite": ["~/.cache", "~/Library/Caches", "~/.local/share", "~/.local/state"]
    },
    // With server-side auto-mode review, the classifier reviews every sandboxed command, so these
    // hosts skip only the per-command host list, not review. Where review runs locally, sandboxed
    // commands to these hosts run unreviewed.
    "network": {
      "allowedDomains": [
        "api.github.com",
        "github.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "release-assets.githubusercontent.com",
        "objects.githubusercontent.com",
        "mise-versions.jdx.dev",
        "nodejs.org"
      ]
    }
  }
}
