{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/zsh",
    "ENABLE_TOOL_SEARCH": "true",
    "NODE_USE_SYSTEM_CA": "1"
  },
  // The marketplace plugins replace these bundled skills; keep them reachable only by name.
  "skillOverrides": {
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "extraKnownMarketplaces": {
    "0xa3b-marketplace": {
      "source": {
        "source": "github",
        "repo": "0xA3B/skills"
      },
      "autoUpdate": true
    }
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read(~/.claude/settings.json)",
      "Read(~/.claude/statusline-command.sh)",
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/rules/**)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git remote -v)",
      "Bash(git fetch *)",
      "Bash(git stash list *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh auth status)",
      "Bash(op whoami)",
      "Bash(op account list *)",
      "Bash(op account get *)"
    ],
    "deny": [
      "Bash(* --show-token*)",
      "Bash(codex *--dangerously-bypass-approvals-and-sandbox*)",
      "Bash(codex *--yolo*)",
      "Bash(codex *danger-full-access*)",
      "Bash(claude *--dangerously-skip-permissions*)",
      "Bash(claude *bypassPermissions*)",
      "Bash(gh auth status --show-token *)",
      "Bash(gh auth status -t *)",
      "Bash(gh auth status * --show-token *)",
      "Bash(gh auth status * -t *)",
      "Bash(gh auth status * -t)",
      "Read(**/.ssh/id_*)",
      "Read(**/.gnupg/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.aws/credentials)",
      "Read(**/.netrc)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.envrc)",
      "Edit(**/.aws/credentials)",
      "Edit(**/.netrc)",
      "Edit(**/.npmrc)",
      "Edit(**/.pypirc)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.codex/auth.json)"
    ],
    // Content-scoped ask rules prompt the user even in auto mode; the classifier cannot clear them.
    "ask": [
      "Bash(sudo *)",
      "Bash(gh auth login *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(uv publish *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "credentials": {
      "files": [
        {
          "mode": "deny",
          "path": "~/.aws"
        },
        {
          "mode": "deny",
          "path": "~/.ssh"
        },
        {
          "mode": "deny",
          "path": "~/.gnupg"
        },
        {
          "mode": "deny",
          "path": "~/.config/gh"
        },
        {
          "mode": "deny",
          "path": "~/.claude/.credentials.json"
        },
        {
          "mode": "deny",
          "path": "~/.codex/auth.json"
        }
      ]
    },
    // Excluded commands run outside the sandbox and go through auto-mode review. Package-manager
    // commands stay sandboxed: registries are not pre-allowed domains, so the first connection to a
    // registry in a session is reviewed by the classifier together with the command that opened it.
    "excludedCommands": [
      "git *",
      "gh *",
      "op *",
      "codex *",
      "claude *",
      "aws *",
      "kubectl *",
      "docker *",
      "ssh *",
      "sudo *"
    ],
    "filesystem": {
      "allowWrite": ["~/.cache", "~/Library/Caches", "~/.local/share", "~/.local/state"]
    },
    // No host is pre-allowed: the first sandboxed connection to any host in a session is reviewed
    // together with the command that opened it. Credentialed tools such as git and gh are excluded
    // above and never need an allowlist entry.
    "network": {
      "allowedDomains": []
    }
  }
}
