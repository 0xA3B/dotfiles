#:schema https://developers.openai.com/codex/config-schema.json
#:tombi schema.strict = false

model_reasoning_summary = "auto"
model_verbosity = "low"
hide_agent_reasoning = false
suppress_unstable_features_warning = false
web_search = "cached"
approvals_reviewer = "auto_review"
approval_policy = "on-request"
allow_login_shell = true
show_raw_agent_reasoning = true
project_doc_max_bytes = 65536

[features]
memories = true
network_proxy = true
prevent_idle_sleep = true
tool_suggest = false
default_mode_request_user_input = true  # Allow the ask user question tools outside of plan mode

# Still under development
code_mode = true
request_permissions_tool = true

# Experimental compaction mode; enable it after the feature stabilizes.
# [features.context_management]
# experimental_mode = true

[features.multi_agent_v2]
enabled = true
max_concurrent_threads_per_session = 10

[agents]
max_concurrent_threads_per_session = 8

[permissions.workspace-code]
description = "Workspace editing to code repositories and allowlisted outbound network access."
extends = ":workspace"

[permissions.workspace-code.filesystem]
# General dirs tools need to be able to write to
"{{ .chezmoi.homeDir }}/.cache" = "write"
"{{ .chezmoi.homeDir }}/Library/Caches" = "write"
"{{ .chezmoi.homeDir }}/.local/share" = "write"
"{{ .chezmoi.homeDir }}/.local/state" = "write"

[permissions.workspace-code.network]
enabled = true
enable_socks5 = false
enable_socks5_udp = false

[permissions.workspace-code.network.domains]
# Allow openai domains to reference official documentation
"chatgpt.com" = "allow"
"api.openai.com" = "allow"
"developers.openai.com" = "allow"
"platform.openai.com" = "allow"
"learn.chatgpt.com" = "allow"

# Allow package managers to run inside the sandbox
"registry.npmjs.org" = "allow"
"pypi.org" = "allow"
"files.pythonhosted.org" = "allow"
"release-assets.githubusercontent.com" = "allow"
"mise-versions.jdx.dev" = "allow"
"nodejs.org" = "allow"
"dl.google.com" = "allow"
"static.rust-lang.org" = "allow"

# Other common and useful APIs
"api.github.com" = "allow"
"github.com" = "allow"

[marketplaces.0xa3b-marketplace]
source_type = "git"
source = "https://github.com/0xA3B/skills.git"
ref = "main"

[desktop]
git-commit-instructions = """
Write only a Conventional Commit message for the supplied git context.

Use `<type>[optional scope][!]: <description>` with an imperative, lowercase subject and no trailing
period. Keep the header at most 88 characters. Choose a scope by intent or stable repository
vocabulary; do not infer a scope from a directory name alone.

Choose `feat`, `fix`, `!`, and `BREAKING CHANGE:` by release impact rather than diff size. Use
`docs`, `refactor`, `test`, `perf`, `build`, `ci`, `style`, `chore`, or `revert` when that type best
describes the result. Name the resulting behavior, boundary, or user-visible outcome in the subject;
use a generic verb such as `update`, `tune`, or `refine` only when a more specific result would be
misleading.

Add a body or footer only for durable context specific to the commit. Do not inventory the changes
or mention tests, lint, generated files, or implementation details unless they are the commit's main
purpose. Return only the commit message.
"""
