# Git execution policy rules. Local read-only commands run inside the sandbox
# and do not need rules. `add` intentionally runs outside the sandbox without
# review because it must update protected Git metadata.
# Commits and other commands that mutate history, refs, the worktree, or remotes
# require contextual review when they need escalation.

# Git global options can move the subcommand to a later argv position. Route
# these forms to review instead of trying to enumerate every later mutation.
prefix_rule(
    pattern = [
        "git",
        [
            "-C",
            "-c",
            "-p",
            "-P",
            "--bare",
            "--config-env",
            "--git-dir",
            "--glob-pathspecs",
            "--icase-pathspecs",
            "--literal-pathspecs",
            "--namespace",
            "--no-pager",
            "--no-replace-objects",
            "--noglob-pathspecs",
            "--paginate",
            "--work-tree",
        ],
    ],
    decision = "prompt",
    justification = "Review Git commands whose global options move the eventual subcommand later in argv.",
    match = [
        "git -C /tmp/repo fetch origin",
        "git -c protocol.ext.allow=always fetch ext::helper",
        "git --git-dir .git commit -m test",
        "git --no-pager status",
    ],
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Allow staging workflows that need to write repository metadata outside the sandbox.",
    match = [
        "git add managed/dot_codex/rules/git.rules",
    ],
    not_match = [
        "git push origin main",
    ],
)

prefix_rule(
    pattern = [
        "git",
        [
            "commit",
            "fetch",
            "push",
            "pull",
            "merge",
            "rebase",
            "reset",
            "cherry-pick",
            "revert",
            "checkout",
            "switch",
            "branch",
            "tag",
            "stash",
            "clean",
            "restore",
            "rm",
            "mv",
            "worktree",
            "submodule",
            "remote",
            "config",
            "notes",
            "replace",
            "update-ref",
            "symbolic-ref",
            "maintenance",
            "gc",
            "prune",
        ],
    ],
    decision = "prompt",
    justification = "Review Git commands that may create commits or mutate history, refs, the worktree, configuration, or remotes.",
    match = [
        "git commit -m test",
        "git fetch origin",
        "git push origin main",
        "git pull --rebase origin main",
        "git reset --hard HEAD~1",
        "git switch feature",
        "git branch -D feature",
        "git config user.email test@example.com",
    ],
    not_match = [
        "git status",
        "git log --oneline",
        "git diff --stat",
        "git show HEAD",
    ],
)
