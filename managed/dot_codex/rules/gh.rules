# GitHub CLI commands may use stored credentials or mutate remote state. Route
# every invocation to approval review so personal account, repository, and
# destination context can be evaluated.

prefix_rule(
    pattern = ["gh"],
    decision = "prompt",
    justification = "Review GitHub CLI commands that need credentials, network access, or execution outside the sandbox.",
    match = ["gh --version", "gh repo view cli/cli", "gh pr create --fill", "gh auth login"],
)

prefix_rule(
    pattern = ["gh", "auth", "status", ["--show-token", "-t"]],
    decision = "forbidden",
    justification = "Do not display stored GitHub authentication tokens.",
    match = ["gh auth status --show-token", "gh auth status -t"],
    not_match = ["gh auth status"],
)

prefix_rule(
    pattern = [
        "gh",
        "auth",
        "status",
        ["--hostname", "-h"],
        "github.com",
        ["--show-token", "-t"],
    ],
    decision = "forbidden",
    justification = "Do not display stored GitHub authentication tokens.",
    match = [
        "gh auth status --hostname github.com --show-token",
        "gh auth status -h github.com -t",
    ],
)

prefix_rule(
    pattern = [
        "gh",
        "auth",
        "status",
        "--hostname=github.com",
        ["--show-token", "-t"],
    ],
    decision = "forbidden",
    justification = "Do not display stored GitHub authentication tokens.",
    match = ["gh auth status --hostname=github.com --show-token"],
)

prefix_rule(
    pattern = ["gh", "auth", "status", "--active", ["--show-token", "-t"]],
    decision = "forbidden",
    justification = "Do not display stored GitHub authentication tokens.",
    match = ["gh auth status --active --show-token"],
)

prefix_rule(
    pattern = [
        "gh",
        "auth",
        "status",
        "--active",
        ["--hostname", "-h"],
        "github.com",
        ["--show-token", "-t"],
    ],
    decision = "forbidden",
    justification = "Do not display stored GitHub authentication tokens.",
    match = ["gh auth status --active --hostname github.com --show-token"],
)

prefix_rule(
    pattern = [
        "gh",
        "auth",
        "status",
        ["--hostname", "-h"],
        "github.com",
        "--active",
        ["--show-token", "-t"],
    ],
    decision = "forbidden",
    justification = "Do not display stored GitHub authentication tokens.",
    match = ["gh auth status --hostname github.com --active --show-token"],
)

prefix_rule(
    pattern = [
        "gh",
        "auth",
        "status",
        "--active",
        "--hostname=github.com",
        ["--show-token", "-t"],
    ],
    decision = "forbidden",
    justification = "Do not display stored GitHub authentication tokens.",
    match = ["gh auth status --active --hostname=github.com --show-token"],
)

prefix_rule(
    pattern = ["gh", "auth", "status", "--json", "hosts", ["--show-token", "-t"]],
    decision = "forbidden",
    justification = "Do not display stored GitHub authentication tokens.",
    match = ["gh auth status --json hosts --show-token"],
)
