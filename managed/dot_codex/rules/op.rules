# 1Password CLI commands may use stored credentials or expose secret-bearing
# data. Route every invocation to approval review so account, vault, child
# command, and output context can be evaluated.

prefix_rule(
    pattern = ["op"],
    decision = "prompt",
    justification = "Review 1Password CLI commands that need credentials, secret access, or execution outside the sandbox.",
    match = ["op --version", "op whoami", "op account list", "op run -- env"],
)
