# Map portable command names to common absolute installation paths so an
# absolute invocation receives the same decision as its basename form.

host_executable(
    name = "git",
    paths = ["/usr/bin/git", "/opt/homebrew/bin/git", "/usr/local/bin/git"],
)

host_executable(
    name = "mise",
    paths = [
        "/opt/homebrew/bin/mise",
        "/usr/local/bin/mise",
        "{{ .chezmoi.homeDir }}/.local/bin/mise",
    ],
)

host_executable(
    name = "gh",
    paths = [
        "/opt/homebrew/bin/gh",
        "/usr/local/bin/gh",
        "{{ .chezmoi.homeDir }}/.local/bin/gh",
        "{{ .chezmoi.homeDir }}/.local/share/mise/shims/gh",
