# Package-manager and publisher CLIs can move a publish or upload subcommand
# behind global options. Route the whole family to approval review so the
# reviewer can distinguish routine dependency work from external publication.

prefix_rule(
    pattern = [["npm", "pnpm", "yarn", "uv", "poetry", "twine"]],
    decision = "prompt",
    justification = "Review package-manager commands because these clients can publish external releases.",
    match = [
        "npm install",
        "npm --registry=https://registry.npmjs.org publish",
        "npm --workspace=pkg publish",
        "pnpm --filter=pkg publish",
        "yarn npm publish",
        "uv --color never publish",
        "poetry --no-interaction publish",
        "twine --config-file .pypirc upload dist/*",
    ],
)

prefix_rule(
    pattern = [["python", "python3"], "-m", "twine"],
    decision = "prompt",
    justification = "Review Twine commands invoked as a Python module because they can upload external releases.",
    match = ["python -m twine check dist/*", "python3 -m twine upload dist/*"],
    not_match = ["python -m pip install twine"],
)

prefix_rule(
    pattern = [["python", "python3"], ["-B", "-E", "-I", "-s", "-S"]],
    decision = "prompt",
    justification = "Review Python leading-option commands that may invoke a package publisher later in argv.",
    match = ["python3 -I -m twine upload dist/*"],
)

# The user-level instructions run managed tools through `mise exec --` in
# non-interactive shells, so cover publisher families behind that wrapper.
prefix_rule(
    pattern = ["mise", "exec", "--", ["npm", "pnpm", "yarn", "uv", "poetry", "twine"]],
    decision = "prompt",
    justification = "Review package-manager commands invoked through mise because these clients can publish external releases.",
    match = [
        "mise exec -- npm install",
        "mise exec -- pnpm --filter=pkg publish",
        "mise exec -- yarn npm publish",
        "mise exec -- uv publish",
        "mise exec -- twine upload dist/*",
    ],
)

prefix_rule(
    pattern = ["mise", "exec", "--", ["python", "python3"], "-m", "twine"],
    decision = "prompt",
    justification = "Review Twine commands invoked as a Python module through mise because they can upload external releases.",
    match = ["mise exec -- python -m twine upload dist/*"],
)

prefix_rule(
    pattern = ["mise", "exec", "--", ["python", "python3"], ["-B", "-E", "-I", "-s", "-S"]],
    decision = "prompt",
    justification = "Review Python leading-option commands through mise that may invoke a package publisher later in argv.",
    match = ["mise exec -- python3 -I -m twine upload dist/*"],
)
