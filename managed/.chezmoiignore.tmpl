{{- /* vim: set filetype=gitignore : */ -}}
# Source-state guidance should not be materialized in $HOME.
**/AGENTS.md
**/CLAUDE.md

# Existing modify-script inputs are source-only.
.npmrc.managed
.config/uv/uv.managed.toml
Library/Application Support/Code/User/settings.managed.jsonc

# Codex and Claude overlays always remain source-only; future modify scripts read them from here.
.claude/CLAUDE.default.md
.claude/settings.managed.jsonc
.claude/settings.default.jsonc
.codex/AGENTS.default.md
.codex/config.managed.toml
.codex/config.default.toml

# Action inputs are consumed from the source tree instead of materializing.
Library/Application Support/Code/User/extensions.managed.txt

# Legacy whole-file agent configs remain source-only if reintroduced.
.claude/CLAUDE.md
.claude/settings.json
.claude/statusline-command.sh
.codex/AGENTS.md
.codex/config.toml

# Bytecode caches written by `uv run` next to inline-script modify_ files.
**/__pycache__
**/__pycache__/**

# Fish writes this file itself and it varies across machines.
.config/fish/fish_variables

# Keep archived shell hooks in the source repo without materializing them into $HOME.
.config/fish/conf.d/disabled/**
.config/zsh/conf.d/disabled/**

# OS specific ignores
{{- if ne .chezmoi.os "darwin" }}
Library/Application Support/Code/User/settings.json
.config/homebrew
.config/homebrew/**
{{- end }}
