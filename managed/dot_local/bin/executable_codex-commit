#!/bin/sh
# Commit current changes with generated Conventional Commit messages by running
# the conventional-commits:commit skill through a non-interactive `codex exec`
# session, so committing hand-made changes doesn't need a full session. Extra
# arguments are passed to the skill as instructions, e.g.
# `codex-commit only the docs changes`.
set -eu

# Requires the conventional-commits plugin from
# https://github.com/0xA3B/skills/tree/main/plugins/git to be
# installed in the resolved Codex home.
prompt="\$git:commit Commit the current worktree changes in the requested scope (all of them by default). Follow the skill's guidance for commit partitioning. Do not push. If a git hook modifies files, inspect those changes, re-stage only the fixes that belong to the affected commit, and retry that commit once. If the retry fails, the requested scope cannot be isolated safely, or the diff contains a clear safety issue such as exposed credentials or unresolved conflict markers, stop and report the blocker. Do not edit working-tree files yourself, bypass hooks, weaken checks, or otherwise work around the blocker."
if [ "$#" -gt 0 ]; then
  prompt="$prompt Additional instructions: $*"
fi

# Workspace-write lets the skill stage hook fixes in the worktree. Non-interactive
# git metadata writes still depend on the active Codex execution-policy rules.
# Disable OTEL exporters so unavailable telemetry endpoints cannot delay this
# headless command's shutdown.
# Capture Codex's progress stream and replay it only when the command fails.
stderr_file=$(mktemp "${TMPDIR:-/tmp}/codex-commit.XXXXXX")
trap 'rm -f "$stderr_file"' 0

if codex exec \
  --model gpt-5.6-luna \
  --config 'model_reasoning_effort="medium"' \
  --config 'otel.exporter="none"' \
  --config 'otel.metrics_exporter="none"' \
  --config 'otel.trace_exporter="none"' \
  --sandbox workspace-write \
  --ephemeral \
  "$prompt" 2>"$stderr_file"; then
  exit 0
else
  status=$?
  cat "$stderr_file" >&2
  exit "$status"
fi
