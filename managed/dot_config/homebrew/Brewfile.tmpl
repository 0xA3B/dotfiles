{{- /* vim: set filetype=ruby : */ -}}
# Curated Homebrew bundle. chezmoi apply installs it through the
# run_onchange_after_10-brew-bundle.sh script whenever this file changes.
#
# Keep developer runtimes in mise or project-local config instead of Homebrew.
# This includes Node, Python, uv, pnpm, Go, and Bun unless a package has a
# specific bootstrap reason to live in Homebrew.
#
# Casks marked auto_updates update themselves; update-brew upgrades the rest.

# Bootstrap and source control
brew "chezmoi"
brew "git"
brew "git-filter-repo"
brew "gh"
brew "mise"

# Shells and shell integrations
brew "bash"
brew "fish"
brew "zsh"
brew "starship"

# Core command-line tools
brew "bat"
brew "cloc"
brew "coreutils"
brew "eza"
brew "fd"
brew "fzf"
brew "glow"
brew "jq"
brew "make"
brew "openssh"
brew "ripgrep"
brew "tmux"
brew "tree"
brew "vivid"
brew "zoxide"

# Editors
brew "vim"
brew "neovim"

# Other command-line tools
brew "nmap"

# Command-line tools distributed as casks
cask "1password-cli"
cask "claude-code@latest"
cask "codex"

# Desktop apps
cask "1password"
cask "betterdisplay"
cask "chatgpt"
cask "claude"
cask "ghostty"
cask "raycast"
cask "rectangle"
cask "shottr"
cask "zed"
{{- if not .work_machine }}

# Desktop apps that IT installs and updates on work machines
cask "google-chrome"
cask "visual-studio-code"

# Personal desktop apps
cask "fastmail"
cask "grok-bot"
cask "helium-browser"
cask "notion"
cask "t3-code"
{{- end }}

# Fonts
cask "font-fira-code-nerd-font"
cask "font-hack-nerd-font"
cask "font-iosevka-nerd-font"
