# vim: set filetype=dosini :
font-family = "FiraCode Nerd Font Mono"
font-size = 14
font-feature = +calt, +liga, +dlig

theme = "Catppuccin Mocha"

clipboard-trim-trailing-spaces = true

# SSH fix for terminfo
shell-integration-features = ssh-env

# Claude Code: Cmd+Enter submits. tmux drops the Cmd modifier, so send Meta+Enter, which the
# managed Claude keybindings bind to chat:submit; plain Enter inserts a newline there.
keybind = cmd+enter=text:\x1b\r
