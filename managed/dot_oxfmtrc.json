{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "proseWrap": "always",
  "insertFinalNewline": true,
  "endOfLine": "lf",
  "sortPackageJson": {
    "sortScripts": true
  },
  "overrides": [
    {
      "files": ["*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist",
    "**/node_modules",
    "**/.cache",
    "**/.pnpm-store",
    "**/.local",
    "**/.venv",
    "**/*.toml",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/uv.lock",
    "**/mise.lock"
  ]
}
