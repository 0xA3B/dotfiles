[user]
	useConfigOnly = true
[init]
	defaultBranch = main
[fetch]
	prune = true
[rebase]
	autoStash = true
[rerere]
	enabled = true
[merge]
	conflictStyle = zdiff3
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[include]
	path = ~/.gitconfig-machine
[includeIf "gitdir:~/Code/personal/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/.local/share/chezmoi/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/Code/work/"]
	path = ~/.gitconfig-work
