from __future__ import annotations

import os
import sys
from pathlib import Path


def add_helper_path() -> None:
    """Add the repo helper library to sys.path."""
    chezmoi_source_dir = os.environ.get("CHEZMOI_SOURCE_DIR")
    if chezmoi_source_dir is None:
        sys.exit("modify_dot_npmrc: CHEZMOI_SOURCE_DIR is not set")
    sys.path.insert(0, str(Path(chezmoi_source_dir).parent / "tools"))


add_helper_path()

from chezmoi_modify.exceptions import ChezmoiModifyError
from chezmoi_modify.line_kv import merge_managed_keys
from chezmoi_modify.source import read_source_text

MANAGED_CONFIG_SOURCE_PATH = "dot_npmrc.managed"


def main() -> None:
    """Merge managed npmrc keys into the live npmrc content."""
    managed = read_source_text(MANAGED_CONFIG_SOURCE_PATH)
    result = merge_managed_keys(sys.stdin.read(), managed)
    for diagnostic in result.diagnostics:
        print(f"{diagnostic.severity}: {diagnostic.message}", file=sys.stderr)
    sys.stdout.write(result.text)


if __name__ == "__main__":
    try:
        main()
    except ChezmoiModifyError as error:
        sys.exit(f"modify_dot_npmrc: {error}")
