// Claude Code settings for every account on every machine. Callers set .claudeDir to the
// account's config directory, such as ~/.claude or ~/.claude-personal.
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  // Session behavior and UI preferences. Change them here instead of through /config or other
  // slash commands, which write to the live file that the next apply overwrites.
  "alwaysThinkingEnabled": true,
  "askUserQuestionTimeout": "never",
  "autoCompactEnabled": true,
  "autoConnectIde": false,
  "autoMemoryEnabled": false,
  "autoUpdatesChannel": "latest",
  "cleanupPeriodDays": 90,
  "editorMode": "normal",
  "enableWorkflows": true,
  "externalEditorContext": true,
  "feedbackSurveyRate": 0,
  "idleCompaction": true,
  "outputStyle": "writing:chat",
  "promptSuggestionEnabled": false,
  "respectGitignore": true,
  "respondToBashCommands": true,
  "skillListingBudgetFraction": 0.03,
  "spinnerTipsEnabled": false,
  "switchModelsOnFlag": false,
  "teammateMode": "in-process",
  "theme": "dark",
  "timeFormat": "24-hour",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoCompactWindow": 500000,
  // Core sets effort only for models whose accounts agree; account overlays set the rest.
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 500000
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 500000
    },
    "claude-haiku-5-5": {
      "effortLevel": "high",
      "autoCompactWindow": 100000
    }
  },
  // Bash commands inherit the environment of the process that launched Claude Code, and the shell
  // snapshot keeps only PATH. The desktop app starts from launchd, outside fish, so mirror the
  // fish exports that tools in the sandbox need. These values must match dot_config/fish/conf.d.
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "16000",
    "CLAUDE_CODE_NEW_INIT": "1",
    "CLAUDE_CODE_SHELL": "/opt/homebrew/bin/bash",
    "ENABLE_TOOL_SEARCH": "true",
    "HOMEBREW_NO_ANALYTICS": "1",
    "HOMEBREW_NO_AUTO_UPDATE": "1",
    "HOMEBREW_NO_ENV_HINTS": "1",
    "MISE_CACHE_DIR": "{{ .chezmoi.homeDir }}/.cache/mise",
    "NODE_USE_SYSTEM_CA": "1",
    "PNPM_HOME": "{{ .chezmoi.homeDir }}/.local/share/pnpm",
    "XDG_CACHE_HOME": "{{ .chezmoi.homeDir }}/.cache",
    "XDG_CONFIG_HOME": "{{ .chezmoi.homeDir }}/.config",
    "XDG_DATA_HOME": "{{ .chezmoi.homeDir }}/.local/share",
    "XDG_RUNTIME_DIR": "{{ .chezmoi.homeDir }}/.local/state/run",
    "XDG_STATE_HOME": "{{ .chezmoi.homeDir }}/.local/state"
  },
  // Claude Code runs CLAUDE_ENV_FILE text before every Bash command, so mise applies the
  // environment of each command's starting directory. The shell snapshot keeps no exports other
  // than PATH, so this cannot live in ~/.bashrc. `-s bash` must match CLAUDE_CODE_SHELL. The hook
  // reruns on compaction and appends to the same file, so the grep guard keeps the line from
  // repeating.
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "grep -qsF 'mise hook-env' \"$CLAUDE_ENV_FILE\" || echo 'eval \"$(mise hook-env -s bash 2>/dev/null)\"' >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ]
  },
  // The marketplace plugins replace these bundled skills; keep them reachable only by name.
  "skillOverrides": {
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{ .claudeDir }}/statusline-command.sh",
    "refreshInterval": 60,
    "hideVimModeIndicator": true
  },
  "extraKnownMarketplaces": {
    "0xa3b-marketplace": {
      "source": {
        "source": "github",
        "repo": "0xA3B/skills"
      },
      "autoUpdate": true
    }
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read({{ .claudeDir }}/settings.json)",
      "Read({{ .claudeDir }}/statusline-command.sh)",
      "Read({{ .claudeDir }}/skills/**)",
      "Read({{ .claudeDir }}/rules/**)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh auth status --active --hostname *)",
      "Bash(op whoami)",
      "Bash(op account list *)",
      "Bash(op account get *)"
    ],
    "deny": [
      "AskUserQuestion",
      "mcp__ccd_turn__wrap_up",
      "Bash(* --show-token*)",
      "Bash(codex *--dangerously-bypass-approvals-and-sandbox*)",
      "Bash(codex *--yolo*)",
      "Bash(codex *danger-full-access*)",
      "Bash(claude *--dangerously-skip-permissions*)",
      "Bash(claude *bypassPermissions*)",
      "Bash(gh auth status -t)",
      "Bash(gh auth status -t *)",
      "Bash(gh auth status * -t)",
      "Bash(gh auth status * -t *)",
      "Bash(gh auth token*)",
      "Bash(security find-generic-password -g *)",
      "Bash(security find-generic-password * -g)",
      "Bash(security find-generic-password * -g *)",
      "Bash(security find-generic-password -w *)",
      "Bash(security find-generic-password * -w)",
      "Bash(security find-generic-password * -w *)",
      // Read deny rules also become sandbox read denies, so these paths stay unreadable to sandboxed
      // commands. Dotenv, npmrc, and PEM files stay readable: denying them broke commands that load
      // .env files, npm, and CA certificate stores.
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/keys/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/sso/**)",
      "Read(~/.aws/cli/cache/**)",
      "Read({{ .claudeDir }}/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(**/*.key)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.netrc)",
      "Edit({{ .claudeDir }}/.credentials.json)",
      "Edit(~/.codex/auth.json)",
      "Edit(~/.gnupg/**)"
    ],
    // Content-scoped ask rules prompt the user even in auto mode; the classifier cannot clear them.
    "ask": [
      "Bash(sudo *)",
      "Bash(gh auth login *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(uv publish *)",
      "Edit(~/.config/**)"
    ]
  },
  // The classifier reviews commands that run outside the sandbox and the first sandboxed connection
  // to each host in a session. It reads loaded CLAUDE.md content, so a repository dependency policy
  // applies to dependency commands automatically. Account overlays add their own rules.
  "autoMode": {
    "allow": ["$defaults"],
    "soft_deny": [
      "$defaults",
      "Unsandboxed Nested Agents: Nested agent CLIs (codex, claude) are excluded from this session's OS sandbox, so their own sandbox/approval layer is the only containment — do not run them with it disabled or weakened. This covers the flags --yolo, --dangerously-bypass-approvals-and-sandbox, -s/--sandbox danger-full-access, -c/--config sandbox_mode=danger-full-access, --dangerously-skip-permissions, and --permission-mode bypassPermissions, AND indirect routes to the same outcome: selecting a codex profile that sets a permissive sandbox_mode, pointing CODEX_HOME (or claude's CLAUDE_CONFIG_DIR/--settings) at a permissive config, or editing ~/.codex or claude settings so a later plain invocation runs unsandboxed. Block by default; allow only with explicit user direction for that specific invocation."
    ],
    "hard_deny": ["$defaults"],
    "environment": ["$defaults"]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    // Allow the macOS trust service, com.apple.trustd.agent. Without it, every client that verifies
    // TLS through Security.framework, such as Go tools, mise, and Terraform, fails with
    // "x509: OSStatus -26276". The trust service is an exfiltration path outside the proxy.
    "enableWeakerNetworkIsolation": true,
    // Exclude only commands that need what the sandbox withholds: the commit-signing agent, SSH
    // remotes, or credentials outside the sandbox. A sudo entry has no effect: calls that start
    // with sudo always stay sandboxed.
    "excludedCommands": [
      "git commit *",
      "git rebase *",
      "git merge *",
      "git cherry-pick *",
      "git revert *",
      "git tag *",
      "git am *",
      "git push *",
      "git fetch *",
      "git pull *",
      "git ls-remote *",
      "git clone *",
      "git submodule *",
      "gh pr checkout *",
      "gh repo clone *",
      "op *",
      "codex *",
      "claude *",
      "aws *",
      "kubectl *",
      "docker *",
      "ssh *"
    ],
    // Allow writes only to the data and state directories that sandboxed tools use, so a sandboxed
    // command cannot change other programs' state.
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/Library/Caches",
        "~/.local/share/mise",
        "~/.local/share/uv",
        "~/.local/share/pnpm",
        "~/.local/share/go",
        "~/.local/state/mise",
        "~/.local/state/gh",
        "~/.local/state/pnpm",
        // pnpm keeps its install and store locks in $XDG_RUNTIME_DIR, which the shells default to
        // ~/.local/state/run, under names that end in the user id. Other programs keep sockets in
        // that directory, so allow only the pnpm lock directories.
        "~/.local/state/run/pnpm-dir-locks-{{ .chezmoi.uid }}",
        "~/.local/state/run/pnpm-store-operation-locks-{{ .chezmoi.uid }}",
        "~/.local/state/run/pnpm-verify-deps-install-locks-{{ .chezmoi.uid }}"
      ],
      // The mise hook applies trusted configs before every Bash command, including unsandboxed
      // ones, so only the user can trust a mise config.
      "denyWrite": ["~/.local/state/mise/trusted-configs"]
    },
    // With server-side auto-mode review, the classifier reviews every sandboxed command, so these
    // hosts skip only the per-command host list, not review. Where review runs locally, sandboxed
    // commands to these hosts run unreviewed.
    "network": {
      "allowedDomains": [
        "api.github.com",
        "github.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "release-assets.githubusercontent.com",
        "objects.githubusercontent.com",
        "mise-versions.jdx.dev",
        "nodejs.org",
        "www.schemastore.org",
        "json.schemastore.org",
        "registry.terraform.io",
        "releases.hashicorp.com"
      ],
      // Terraform providers and TFLint plugins handshake over a Unix socket in TMPDIR. Projects
      // point TMPDIR here for those tools, so the sandbox allows sockets in this one directory.
      "allowUnixSockets": ["~/.cache/terraform-tmp"]
    }
  }
}
