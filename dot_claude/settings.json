{
  "respectGitignore": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read(~/.claude/settings.json)",
      "Read(~/.claude/statusline-command.sh)",
      "Read(~/.claude/skills/*)",
      "Read(~/.claude/rules/*)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(claude -p *)",
      "Bash(gh version)",
      "Bash(gh auth status *)",
      "Bash(gh repo view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue status *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr status *)",
      "Bash(gh pr checks *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh config get *)",
      "Bash(gh config list *)",
      "Bash(gh status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git version)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git describe *)",
      "Bash(git merge-base *)",
      "Bash(git shortlog *)",
      "Bash(git show-ref *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git ls-remote *)",
      "Bash(git cat-file *)",
      "Bash(git diff-files *)",
      "Bash(git diff-index *)",
      "Bash(git diff-tree *)",
      "Bash(git for-each-ref *)",
      "Bash(git count-objects *)",
      "Bash(git fsck *)",
      "Bash(git config --get *)",
      "Bash(git config --get-all *)",
      "Bash(git config --get-regexp *)",
      "Bash(git config --list *)",
      "Bash(git config -l *)",
      "Bash(git branch --list *)",
      "Bash(git branch -l *)",
      "Bash(git branch -a *)",
      "Bash(git branch -r *)",
      "Bash(git branch --show-current *)",
      "Bash(git branch --contains *)",
      "Bash(git branch --no-contains *)",
      "Bash(git branch --points-at *)",
      "Bash(git tag --list *)",
      "Bash(git tag -l *)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git remote get-url *)",
      "Bash(git reflog show *)",
      "Bash(git reflog list *)",
      "Bash(git reflog exists *)",
      "Bash(git stash list *)",
      "Bash(git stash show *)",
      "Bash(git worktree list *)",
      "Bash(git submodule status *)",
      "Bash(git submodule summary *)",
      "Bash(glab version)",
      "Bash(glab auth status *)",
      "Bash(glab repo view *)",
      "Bash(glab mr list *)",
      "Bash(glab mr view *)",
      "Bash(glab mr diff *)",
      "Bash(glab ci status *)",
      "Bash(glab ci get *)",
      "Bash(glab ci trace *)",
      "Bash(glab ci lint *)",
      "Bash(glab pipeline list *)",
      "Bash(glab pipeline view *)",
      "Bash(glab pipeline status *)",
      "Bash(op run *)",
      "Bash(op whoami)",
      "Bash(op account list *)",
      "Bash(op account get *)",
      "Bash(op vault list *)",
      "Bash(op vault get *)"
    ],
    "deny": [
      "Read(**/.aws/credentials)",
      "Read(**/.ssh/id_*)",
      "Read(**/.gnupg/**)",
      "Read(**/.envrc)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(gh auth login *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh release edit *)",
      "Bash(gh release upload *)",
      "Bash(gh release delete-asset *)",
      "Bash(gh repo create *)",
      "Bash(gh repo delete *)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(glab auth login *)",
      "Bash(glab issue *)",
      "Bash(glab release *)",
      "Bash(glab config *)",
      "Bash(glab repo create *)",
      "Bash(glab repo delete *)"
    ],
    "ask": [
      "Bash(sudo *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["git *", "gh *", "glab *", "op *", "codex *", "sudo *"]
  }
}
