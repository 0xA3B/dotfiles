{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  // Pin GitHub Actions to digests, so an automerged update runs the code its CI run tested even if
  // the release tag later moves.
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":enablePreCommit",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "America/New_York",
  // Fridays, midnight–9:59 AM Eastern.
  "schedule": ["* 0-9 * * 5"],
  // Match the pnpm, mise, and uv cooldowns.
  "minimumReleaseAge": "3 days",
  // Update in-range versions only in lockfiles. A release outside a bound moves the bound; the
  // reviewed exceptions below hold those PRs for release-note review.
  "rangeStrategy": "update-lockfile",
  // Keep PR checks current with main.
  "rebaseWhen": "behind-base-branch",
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "labels": ["dependencies"],
  // Lockfile maintenance is the only automated path for in-range runtime fixes, which GitHub
  // advisories do not cover, so it runs weekly and automerges once CI passes.
  "lockFileMaintenance": {
    "enabled": true,
    // Saturdays, midnight–9:59 AM Eastern.
    "schedule": ["* 0-9 * * 6"],
    // pnpm, uv, and mise enforce the cooldown on every resolution they select.
    "minimumReleaseAge": null,
    "automerge": true
  },
  // Bypass Renovate cooldowns for security fixes.
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "labels": ["dependencies", "security"]
  },
  // Match modify scripts, which have no `.py` extension. Inline dependencies have no lockfile, so
  // only releases outside their bounds open PRs.
  "pep723": {
    "managerFilePatterns": ["/(^|/)modify_[^/]+$/"]
  },
  "packageRules": [
    // Manager behavior.
    {
      "description": "Preserve mise ranges with npm versioning",
      // Default coerced semver would replace global config prefixes such as `go = "1.27"` with
      // exact versions.
      "matchManagers": ["mise"],
      "versioning": "npm"
    },
    // Automerge by default, since CI catches breaking releases. The reviewed exceptions below hold
    // updates that rewrite a version in a manifest.
    {
      "description": "Automerge in-range and tooling updates",
      // Leave out pep723: its dependencies have no lockfile, so every pep723 update rewrites a
      // bound.
      "matchManagers": ["npm", "pep621", "github-actions", "pre-commit", "mise"],
      "groupName": "automerged dependencies",
      "automerge": true
    },
    {
      "description": "Give each major its own PR",
      // A breaking major then cannot hold back the rest of the automerged group.
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    // Reviewed exceptions.
    {
      "description": "Review updates that rewrite a manifest version",
      // An in-range update changes only a lockfile and keeps the manifest value. An update that
      // moves a bound, an exact pin, or a global mise config prefix, or that replaces a package,
      // waits for review and is the release-note review for that release. GitHub Actions and
      // pre-commit pin exact versions that every update rewrites, so this rule leaves them out and
      // they stay automerged. Clear the group so a reviewed PR cannot hold back the automerged
      // group.
      "matchManagers": ["npm", "pep621", "pep723", "mise"],
      "matchJsonata": ["newValue != currentValue or updateType = 'replacement'"],
      "groupName": null,
      "automerge": false
    },
    {
      "description": "Keep commitlint majors in one PR",
      // The CLI and its config release together, and the rules above clear the monorepo group.
      "matchPackageNames": ["@commitlint/**"],
      "matchUpdateTypes": ["major"],
      "groupName": "commitlint"
    },
    {
      "description": "Group global mise tools",
      // The chezmoi-managed global mise config has no lockfile, so every update rewrites a prefix
      // and waits for review under the rule above. That review matters because CI never installs
      // this config.
      "matchManagers": ["mise"],
      "matchFileNames": ["managed/**"],
      "groupName": "global mise tools"
    },
    // Lockfile maintenance.
    {
      "description": "Keep lockfile maintenance in one PR",
      // Clear the group names set above. Renovate otherwise opens one
      // `lock-file-maintenance-<group>` PR per group.
      "matchUpdateTypes": ["lockFileMaintenance"],
      "groupName": null
    },
    // Keep runtime exclusions last so they take precedence.
    {
      "description": "Keep the Python version file manual",
      "matchManagers": ["pyenv"],
      "enabled": false
    },
    {
      "description": "Keep mise runtime versions manual",
      // Mise runtimes resolve to package names such as python/cpython, so match dependency names.
      "matchManagers": ["mise"],
      "matchDepNames": ["node", "python"],
      "enabled": false
    },
    {
      "description": "Keep the Python requirement manual",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Keep npm engine constraints manual",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines", "devEngines.runtime"],
      "enabled": false
    }
  ]
}
