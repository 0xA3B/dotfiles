{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":enablePreCommit"],
  "timezone": "America/New_York",
  // Fridays, midnight–9:59 AM Eastern.
  "schedule": ["* 0-9 * * 5"],
  // Match the pnpm, mise, and uv cooldowns.
  "minimumReleaseAge": "3 days",
  // Preserve unbounded dependencies; update in-range versions only in lockfiles.
  "rangeStrategy": "update-lockfile",
  // Keep PR checks current with main.
  "rebaseWhen": "behind-base-branch",
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "labels": ["dependencies"],
  // Lockfile maintenance is the only automated path for in-range runtime fixes, which GitHub
  // advisories do not cover, so it runs weekly and automerges once CI passes.
  "lockFileMaintenance": {
    "enabled": true,
    // Saturdays, midnight–9:59 AM Eastern.
    "schedule": ["* 0-9 * * 6"],
    "automerge": true
  },
  // Bypass Renovate cooldowns for security fixes.
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "labels": ["dependencies", "security"]
  },
  // Match extensionless modify scripts. Inline dependencies have no lockfile;
  // only releases outside their major-bounded ranges trigger PRs.
  "pep723": {
    "managerFilePatterns": ["/(^|/)modify_[^/]+$/"]
  },
  "packageRules": [
    // Group updates by ecosystem.
    {
      "description": "Group npm updates",
      "matchManagers": ["npm"],
      "groupName": "npm dependencies"
    },
    {
      "description": "Group Python updates",
      "matchManagers": ["pep621", "pep723"],
      "groupName": "python dependencies"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group pre-commit updates",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Group mise tool updates",
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "description": "Separate npm majors",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm major dependencies"
    },
    {
      "description": "Separate Python majors",
      "matchManagers": ["pep621", "pep723"],
      "matchUpdateTypes": ["major"],
      "groupName": "python major dependencies"
    },
    // Automerge patches and stable minors in one group after a longer cooldown; Friday runs mean a
    // 7–14-day delay. A 0.x minor can break like a major, so it waits for review. pep723 is
    // excluded to keep inline dependency range changes subject to review.
    {
      "description": "Automerge patches",
      "matchManagers": ["npm", "pep621", "github-actions", "pre-commit", "mise"],
      "matchUpdateTypes": ["patch"],
      "groupName": "automerged dependencies",
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "description": "Automerge stable minors",
      "matchManagers": ["npm", "pep621", "github-actions", "pre-commit", "mise"],
      "matchCurrentVersion": "!/^v?0\\./",
      "matchUpdateTypes": ["minor"],
      "groupName": "automerged dependencies",
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "description": "Review global mise tools separately",
      // The chezmoi-managed global mise config sets every machine's baseline, and CI never
      // installs it, so its updates skip automerge and the longer automerge cooldown. Renovate
      // creates a lockfile maintenance update for every mise file, even one without a lockfile,
      // so match only version updates to keep the combined maintenance branch automerging.
      "matchManagers": ["mise"],
      "matchFileNames": ["managed/**"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "global mise tools",
      "minimumReleaseAge": "3 days",
      "automerge": false
    },
    {
      "description": "Combine lockfile maintenance; let pnpm, uv, and mise enforce cooldowns",
      // Clear the ecosystem group names, which otherwise split maintenance into one PR per group.
      "matchManagers": ["npm", "pep621", "mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "groupName": null,
      "minimumReleaseAge": null
    },
    {
      "description": "Preserve mise ranges with npm versioning",
      // Default coerced semver replaces ranges with exact versions.
      "matchManagers": ["mise"],
      "versioning": "npm"
    },
    // Keep runtime exclusions last so they take precedence.
    {
      "description": "Keep the Python version file manual",
      "matchManagers": ["pyenv"],
      "enabled": false
    },
    {
      "description": "Keep mise runtime versions manual",
      // Mise runtimes resolve to package names such as python/cpython, so match dependency names.
      "matchManagers": ["mise"],
      "matchDepNames": ["node", "python"],
      "enabled": false
    },
    {
      "description": "Keep the Python requirement manual",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Keep npm engine constraints manual",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines", "devEngines.runtime"],
      "enabled": false
    }
  ]
}
