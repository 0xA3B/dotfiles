{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":enablePreCommit"],
  "timezone": "America/New_York",
  // Fridays, midnight–9:59 AM Eastern.
  "schedule": ["* 0-9 * * 5"],
  // Match the pnpm, mise, and uv cooldowns.
  "minimumReleaseAge": "3 days",
  // Preserve unbounded dependencies; update in-range versions only in lockfiles.
  "rangeStrategy": "update-lockfile",
  // Keep PR checks current with main.
  "rebaseWhen": "behind-base-branch",
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    // First Saturday each month, midnight–9:59 AM Eastern.
    "schedule": ["* 0-9 1-7 * 6"]
  },
  // Bypass Renovate cooldowns for security fixes.
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "labels": ["dependencies", "security"]
  },
  // Match extensionless modify scripts. Inline dependencies have no lockfile;
  // only releases outside their major-bounded ranges trigger PRs.
  "pep723": {
    "managerFilePatterns": ["/(^|/)modify_[^/]+$/"]
  },
  "packageRules": [
    {
      "description": "Group npm updates",
      "matchManagers": ["npm"],
      "groupName": "npm dependencies"
    },
    {
      "description": "Automerge stable npm patches",
      "matchManagers": ["npm"],
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["patch"],
      "groupName": "npm stable patch dependencies",
      // Longer cooldown for automerge; Friday runs mean a 7–14-day delay.
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "description": "Separate npm majors",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm major dependencies"
    },
    {
      "description": "Group Python updates",
      "matchManagers": ["pep621", "pep723"],
      "groupName": "python dependencies"
    },
    {
      "description": "Automerge stable locked Python patches",
      // Keep inline dependency range changes subject to review.
      "matchManagers": ["pep621"],
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["patch"],
      "groupName": "python stable patch dependencies",
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "description": "Separate Python majors",
      "matchManagers": ["pep621", "pep723"],
      "matchUpdateTypes": ["major"],
      "groupName": "python major dependencies"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Group pre-commit updates",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Group mise tool updates",
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "description": "Preserve mise ranges with npm versioning",
      // Default coerced semver replaces ranges with exact versions.
      "matchManagers": ["mise"],
      "versioning": "npm"
    },
    {
      "description": "Separate lockfile maintenance; let pnpm and uv enforce cooldowns",
      "matchManagers": ["npm", "pep621"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "groupName": null,
      "minimumReleaseAge": null
    },
    {
      "description": "Keep mise lockfile refreshes manual",
      // Backend artifacts can bypass the tool cooldown.
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    },
    // Keep runtime exclusions last so they take precedence.
    {
      "description": "Keep Node.js and Python version files manual",
      "matchManagers": ["nodenv", "pyenv"],
      "enabled": false
    },
    {
      "description": "Keep mise runtime versions manual",
      "matchManagers": ["mise"],
      "matchPackageNames": ["node", "python"],
      "enabled": false
    },
    {
      "description": "Keep the Python requirement manual",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "description": "Keep npm engine constraints manual",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    }
  ]
}
