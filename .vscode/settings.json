{
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always",
    "source.fixAll.ruff": "always",
    "source.organizeImports.ruff": "always"
  },
  "editor.rulers": [100],
  "files.associations": {
    "**/.chezmoi.toml.tmpl": "toml",
    "**/.chezmoiignore.tmpl": "ignore",
    "**/dot_config/fish/themes/*.theme": "shellscript",
    "**/dot_config/ghostty/config": "properties",
    "**/dot_config/git/ignore": "ignore",
    "**/dot_config/tmux/tmux.conf": "shellscript",
    "**/dot_config/uv/modify_uv.toml": "python",
    "**/dot_config/yamllint/config": "yaml",
    "**/private_Code/User/modify_settings.json": "python",
    "**/dot_npmrc.managed": "properties",
    "**/modify_private_dot_npmrc": "python",
    "**/dot_vimrc": "Vimscript",
    "**/dot_zshrc": "shellscript",
    "mise.lock": "toml"
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "python.analysis.extraPaths": ["./tools"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.organizeImports": true,
  "stylua.disableVersionCheck": true,
  "stylua.searchBinaryInPATH": false,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[toml]": {
    "editor.defaultFormatter": "tombi-toml.tombi",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "files.trimTrailingWhitespace": false
  },
  "[ignore]": {
    "editor.formatOnSave": false
  }
}
