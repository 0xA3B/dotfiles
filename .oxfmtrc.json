{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "proseWrap": "always",
  "insertFinalNewline": true,
  "endOfLine": "lf",
  "sortPackageJson": {
    "sortScripts": true
  },
  "overrides": [
    {
      "files": ["*.toml"],
      "options": {
        "tabWidth": 4
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".cache",
    ".pnpm-store",
    ".local",
    "pnpm-lock.yaml",
    "dot_config/nvim/lazy-lock.json",
    "dot_config/uv/modify_uv.toml"
  ]
}
