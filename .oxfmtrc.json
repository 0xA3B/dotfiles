{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "proseWrap": "always",
  "insertFinalNewline": true,
  "endOfLine": "lf",
  "sortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".cache",
    ".pnpm-store",
    ".local",
    "**/*.toml",
    "pnpm-lock.yaml",
    "managed/dot_config/nvim/lazy-lock.json",
    "managed/private_Library/private_Application Support/private_Code/User/modify_private_settings.json",
    "managed/private_Library/private_Application Support/private_Code/User/settings.managed.jsonc"
  ]
}
