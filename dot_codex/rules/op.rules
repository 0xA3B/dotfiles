# 1password execution policy rules.
# Unlisted op subcommands will still prompt by default when escalation is requested.

prefix_rule(
    pattern = ["op", ["run"]],
    decision = "allow",
    justification = "Automatically allow `op run` commands without prompting.",
    match = [
        "op run -- env",
        "op run -- printenv",
    ],
    not_match = [
        "op item get Example",
    ],
)

prefix_rule(
    pattern = ["op", "whoami"],
    decision = "allow",
    justification = "Allowed account identity inspection.",
    match = [
        "op whoami",
    ],
    not_match = [
        "op signin",
    ],
)

prefix_rule(
    pattern = ["op", "account", ["list", "get"]],
    decision = "allow",
    justification = "Allowed account metadata inspection.",
    match = [
        "op account list",
        "op account get my",
    ],
    not_match = [
        "op account add",
    ],
)

prefix_rule(
    pattern = ["op", "vault", ["list", "get"]],
    decision = "allow",
    justification = "Allowed vault metadata inspection.",
    match = [
        "op vault list",
        "op vault get Private",
    ],
    not_match = [
        "op vault create Test",
    ],
)
